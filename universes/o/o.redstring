      "d5529297-a714-421a-b50f-a800f8979328": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:d5529297-a714-421a-b50f-a800f8979328",
        "rdfs:label": "WikiFeet",
        "rdfs:comment": "wikiFeet is a photo-sharing foot fetish website dedicated to sharing photos of celebrities' feet. In 2016, it was described by Vice Media's Lauren Oyler as \"...the most extensive online message board and photo gallery of women's feet on the Internet\". It mostly includes images of the feet of famous actors, actresses, singers and other entertainers, though some politicians' and athletes feet are also featured on the site. There is also a pornographic version of the site called WikiFeetX which posts the feet of pornographic actors.",
        "name": "WikiFeet",
        "description": "wikiFeet is a photo-sharing foot fetish website dedicated to sharing photos of celebrities' feet. In 2016, it was described by Vice Media's Lauren Oyler as \"...the most extensive online message board and photo gallery of women's feet on the Internet\". It mostly includes images of the feet of famous actors, actresses, singers and other entertainers, though some politicians' and athletes feet are also featured on the site. There is also a pornographic version of the site called WikiFeetX which posts the feet of pornographic actors.",
        "rdfs:seeAlso": [
          "https://en.wikipedia.org/wiki/WikiFeet",
          "http://dbpedia.org/resource/WikiFeet"
        ],
