      "cdc9b6b1-6700-4342-bf10-1a22524a3a5a": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:cdc9b6b1-6700-4342-bf10-1a22524a3a5a",
        "rdfs:label": "Jiminy Cricket",
        "rdfs:comment": "Jiminy Cricket is the Disney version of the Talking Cricket, a fictional character created by Italian writer Carlo Collodi for his 1883 children's book The Adventures of Pinocchio, which Walt Disney adapted into the animated film Pinocchio in 1940. Originally an unnamed, minor character in Collodi's novel who is killed by Pinocchio before returning as a ghost, he was transformed for the Disney adaptation into a comical and wisecracking partner who accompanies Pinocchio on his adventures, having been appointed by the Blue Fairy to serve as Pinocchio's official conscience. In the film, he sings \"When You Wish Upon a Star\", the Walt Disney Company's signature song, and \"Give a Little Whistle\".",
        "name": "Jiminy Cricket",
        "description": "Jiminy Cricket is the Disney version of the Talking Cricket, a fictional character created by Italian writer Carlo Collodi for his 1883 children's book The Adventures of Pinocchio, which Walt Disney adapted into the animated film Pinocchio in 1940. Originally an unnamed, minor character in Collodi's novel who is killed by Pinocchio before returning as a ghost, he was transformed for the Disney adaptation into a comical and wisecracking partner who accompanies Pinocchio on his adventures, having been appointed by the Blue Fairy to serve as Pinocchio's official conscience. In the film, he sings \"When You Wish Upon a Star\", the Walt Disney Company's signature song, and \"Give a Little Whistle\".",
        "rdfs:seeAlso": [
          "https://en.wikipedia.org/wiki/Jiminy_Cricket",
          "http://dbpedia.org/resource/Jimminy_Cricket"
        ],
