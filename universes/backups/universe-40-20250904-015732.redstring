      "d38a3bb1-3873-4853-91ca-3f935754e5a4": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:d38a3bb1-3873-4853-91ca-3f935754e5a4",
        "rdfs:label": "New Thing",
        "rdfs:comment": "New Thing! is a 2005 compilation album of jazz music released by Soul Jazz Records. The album compiles jazz music following social and musical changes in the jazz scene predominantly in the 1970s with artists ranging from Alice Coltrane, Sun Ra and Archie Shepp. Despite its title, the music is not specifically related to a specific group of free jazz musicians sometimes coined as the \"new thing\". On its release, the album received praise from publications such as AllMusic, Exclaim! and the JazzTimes.",
        "name": "New Thing",
        "description": "New Thing! is a 2005 compilation album of jazz music released by Soul Jazz Records. The album compiles jazz music following social and musical changes in the jazz scene predominantly in the 1970s with artists ranging from Alice Coltrane, Sun Ra and Archie Shepp. Despite its title, the music is not specifically related to a specific group of free jazz musicians sometimes coined as the \"new thing\". On its release, the album received praise from publications such as AllMusic, Exclaim! and the JazzTimes.",
